@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medicare Dashboard</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-wrapper">
        <!-- Dashboard Sidebar -->
        <aside class="dashboard-sidebar">
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <i class="bi bi-heart-pulse-fill text-primary fs-3"></i>
                <div>
                    <h6 class="text-white fw-bold mb-0">Medicare Clinic</h6>
                    <small class="badge bg-primary text-wrap">@User.FindFirstValue(ClaimTypes.Role) Portal</small>
                </div>
            </div>

            @{
                var role = User.FindFirstValue(ClaimTypes.Role);
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }

            @if (role == "Patient")
            {
                <div class="sidebar-heading">Patient Menu</div>
                <ul class="sidebar-nav">
                    <li>
                        <a asp-controller="Patient" asp-action="Index" class="sidebar-link @(currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i> Overview
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Patient" asp-action="Book" class="sidebar-link @(currentAction == "Book" ? "active" : "")">
                            <i class="bi bi-calendar-plus"></i> Book Appointment
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Patient" asp-action="Appointments" class="sidebar-link @(currentAction == "Appointments" ? "active" : "")">
                            <i class="bi bi-calendar-check"></i> My Appointments
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Patient" asp-action="Profile" class="sidebar-link @(currentAction == "Profile" ? "active" : "")">
                            <i class="bi bi-person-circle"></i> My Profile
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Patient" asp-action="ChangePassword" class="sidebar-link @(currentAction == "ChangePassword" ? "active" : "")">
                            <i class="bi bi-shield-lock"></i> Change Password
                        </a>
                    </li>
                </ul>
            }
            else if (role == "Doctor")
            {
                <div class="sidebar-heading">Doctor Menu</div>
                <ul class="sidebar-nav">
                    <li>
                        <a asp-controller="Doctor" asp-action="Index" class="sidebar-link @(currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i> Dashboard Overview
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Doctor" asp-action="Schedule" class="sidebar-link @(currentAction == "Schedule" ? "active" : "")">
                            <i class="bi bi-calendar3"></i> Daily Schedule
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Doctor" asp-action="Requests" class="sidebar-link @(currentAction == "Requests" ? "active" : "")">
                            <i class="bi bi-bell"></i> Pending Requests
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Doctor" asp-action="Availability" class="sidebar-link @(currentAction == "Availability" ? "active" : "")">
                            <i class="bi bi-clock-history"></i> Manage Slots
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Doctor" asp-action="Profile" class="sidebar-link @(currentAction == "Profile" ? "active" : "")">
                            <i class="bi bi-person-vcard"></i> Profile Info
                        </a>
                    </li>
                </ul>
            }
            else if (role == "Admin")
            {
                <div class="sidebar-heading">Administration</div>
                <ul class="sidebar-nav">
                    <li>
                        <a asp-controller="Admin" asp-action="Index" class="sidebar-link @(currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i> Admin Dashboard
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Doctors" class="sidebar-link @(currentAction == "Doctors" || currentAction == "DoctorForm" ? "active" : "")">
                            <i class="bi bi-person-badge"></i> Doctors CRUD
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Patients" class="sidebar-link @(currentAction == "Patients" || currentAction == "PatientForm" ? "active" : "")">
                            <i class="bi bi-people"></i> Patients CRUD
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Departments" class="sidebar-link @(currentAction == "Departments" || currentAction == "DepartmentForm" ? "active" : "")">
                            <i class="bi bi-hospital"></i> Departments
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Appointments" class="sidebar-link @(currentAction == "Appointments" ? "active" : "")">
                            <i class="bi bi-journal-medical"></i> Appointments
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Reports" class="sidebar-link @(currentAction == "Reports" ? "active" : "")">
                            <i class="bi bi-graph-up-arrow"></i> Reports & Stats
                        </a>
                    </li>
                </ul>
            }

            <hr class="border-secondary my-4" />
            <div class="px-2">
                <a asp-controller="Home" asp-action="Index" class="sidebar-link text-info">
                    <i class="bi bi-globe"></i> Back to Website
                </a>
            </div>
        </aside>

        <!-- Dashboard Main Content Area -->
        <div class="dashboard-content d-flex flex-column">
            <!-- Top Dashboard Bar -->
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <h4 class="fw-bold mb-0 text-dark">@ViewData["Title"]</h4>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <button class="btn btn-light border dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle text-primary fs-5"></i>
                            <span class="fw-semibold">@User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><span class="dropdown-header">Signed in as @role</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Toast Messages -->
            @await Html.PartialAsync("_NotificationToast")

            <!-- Page Body -->
            <div class="flex-grow-1">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
