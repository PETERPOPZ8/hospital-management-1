@model HospitalAppointmentSystem.ViewModels.PatientDashboardViewModel
@{
    ViewData["Title"] = "Patient Overview";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- Welcome Banner -->
<div class="bg-primary text-white p-4 rounded-3 mb-4 shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h3 class="fw-bold mb-1"><i class="bi bi-emoji-smile me-2"></i> Welcome back, @Model.PatientName!</h3>
            <p class="mb-0 text-white-50">Manage your clinic consultations, check upcoming appointments, and view prescription records.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Book" class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i> Book Appointment
            </a>
        </div>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-blue"><i class="bi bi-calendar-check"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-dark">@Model.TotalAppointments</h4>
                <span class="text-muted small">Total Bookings</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-teal"><i class="bi bi-clock-history"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-teal">@Model.UpcomingAppointmentsCount</h4>
                <span class="text-muted small">Upcoming</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-green"><i class="bi bi-check-circle"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-success">@Model.CompletedAppointmentsCount</h4>
                <span class="text-muted small">Completed</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-red"><i class="bi bi-x-circle"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-danger">@Model.CancelledAppointmentsCount</h4>
                <span class="text-muted small">Cancelled</span>
            </div>
        </div>
    </div>
</div>

<!-- Next Appointment Card & Recent History -->
<div class="row g-4">
    <!-- Next Appointment Highlight -->
    <div class="col-lg-5">
        <div class="med-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="bi bi-bell-fill text-warning me-2"></i> Next Upcoming Appointment</h5>
            @if (Model.NextAppointment == null)
            {
                <div class="text-center py-4">
                    <i class="bi bi-calendar-x text-muted display-4"></i>
                    <p class="text-muted mt-3 mb-3">You have no upcoming appointments scheduled.</p>
                    <a asp-action="Book" class="btn btn-sm btn-primary-custom">Book an Appointment</a>
                </div>
            }
            else
            {
                var appt = Model.NextAppointment;
                <div class="bg-light p-3 rounded-3 mb-3 border border-primary border-opacity-25">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge badge-status badge-@appt.Status.ToLower()">@appt.Status</span>
                        <small class="text-muted">Ref: #@appt.AppointmentId</small>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Dr. @appt.Doctor.User.FullName</h5>
                    <p class="text-primary small mb-2">@appt.Doctor.Department.DepartmentName (@appt.Doctor.Specialization)</p>

                    <div class="d-grid gap-2 small text-secondary">
                        <div><i class="bi bi-calendar3 text-primary me-2"></i> <strong>Date:</strong> @appt.AppointmentDate.ToString("dddd, MMMM dd, yyyy")</div>
                        <div><i class="bi bi-clock text-primary me-2"></i> <strong>Time:</strong> @DateTime.Today.Add(appt.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(appt.EndTime).ToString("hh:mm tt")</div>
                        <div><i class="bi bi-chat-left-text text-primary me-2"></i> <strong>Reason:</strong> @appt.Reason</div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-outline-custom flex-grow-1">View Details</a>
                    <a asp-action="Reschedule" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-warning text-dark fw-semibold flex-grow-1">Reschedule</a>
                </div>
            }
        </div>
    </div>

    <!-- Recent Appointments Table -->
    <div class="col-lg-7">
        <div class="med-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text text-primary me-2"></i> Recent Appointments</h5>
                <a asp-action="Appointments" class="small fw-semibold text-primary text-decoration-none">View All</a>
            </div>

            @if (!Model.RecentAppointments.Any())
            {
                <p class="text-muted text-center py-4">No appointment history found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Doctor</th>
                                <th>Date & Time</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var appt in Model.RecentAppointments)
                            {
                                <tr>
                                    <td class="fw-semibold">Dr. @appt.Doctor.User.FullName</td>
                                    <td>
                                        <div>@appt.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@DateTime.Today.Add(appt.StartTime).ToString("hh:mm tt")</small>
                                    </td>
                                    <td><span class="badge badge-status badge-@appt.Status.ToLower()">@appt.Status</span></td>
                                    <td>
                                        <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-light border text-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
