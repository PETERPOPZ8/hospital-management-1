@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="text-primary fw-bold text-uppercase small">About Medicare Clinic</span>
            <h2 class="fw-bold text-dark mb-3">Pioneering Academic & Clinical Healthcare Management</h2>
            <p class="text-muted leading-relaxed">Medicare Clinic is a state-of-the-art medical appointment and healthcare administration platform designed to connect patients with top-tier medical specialists.</p>
            <p class="text-muted leading-relaxed">Built with ASP.NET Core MVC, EF Core, and SQL Server, our system optimizes clinical scheduling, eliminates waiting room bottlenecks, and facilitates seamless record-keeping for doctors and administrators.</p>
        </div>
        <div class="col-lg-6">
            <div class="p-4 bg-primary text-white rounded-4 shadow-lg">
                <h4 class="fw-bold mb-3"><i class="bi bi-heart-pulse text-info me-2"></i> Our Mission & Values</h4>
                <ul class="list-unstyled d-grid gap-3 mb-0">
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-info fs-5"></i>
                        <div><strong>Patient Centric Care:</strong> Seamless online booking and real-time schedule updates.</div>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-info fs-5"></i>
                        <div><strong>Clinical Efficiency:</strong> Digital consultation notes and automated schedule management for doctors.</div>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-info fs-5"></i>
                        <div><strong>Security & Compliance:</strong> Encrypted passwords, role-based authorization, and reliable data protection.</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Facilities -->
    <div class="my-5">
        <h3 class="fw-bold text-dark text-center mb-4">World-Class Healthcare Facilities</h3>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="med-card p-4 h-100">
                    <div class="stat-icon stat-icon-blue mx-auto mb-3"><i class="bi bi-hospital fs-3"></i></div>
                    <h5 class="fw-bold">Modern Outpatient Clinics</h5>
                    <p class="text-muted small">Equipped with specialized diagnostic technology across Cardiology, Neurology, and Pediatrics.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="med-card p-4 h-100">
                    <div class="stat-icon stat-icon-teal mx-auto mb-3"><i class="bi bi-clock-history fs-3"></i></div>
                    <h5 class="fw-bold">24/7 Emergency Response</h5>
                    <p class="text-muted small">Round-the-clock emergency desk and rapid triage support for critical patients.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="med-card p-4 h-100">
                    <div class="stat-icon stat-icon-green mx-auto mb-3"><i class="bi bi-shield-check fs-3"></i></div>
                    <h5 class="fw-bold">Digital Medical Records</h5>
                    <p class="text-muted small">Centralized patient portal for consultation histories, prescriptions, and follow-ups.</p>
                </div>
            </div>
        </div>
    </div>
</div>
