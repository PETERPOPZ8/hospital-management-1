@model HospitalAppointmentSystem.ViewModels.DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Portal";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- Welcome Banner -->
<div class="bg-primary text-white p-4 rounded-3 mb-4 shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h3 class="fw-bold mb-1"><i class="bi bi-hospital me-2"></i> Dr. @Model.DoctorName</h3>
            <p class="mb-0 text-white-50">Department of @Model.Specialization | Clinical Schedule & Consultation Desk</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Schedule" class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm">
                <i class="bi bi-calendar-day me-1"></i> Today's Schedule
            </a>
        </div>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-blue"><i class="bi bi-calendar-event"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-dark">@Model.TodayAppointmentsCount</h4>
                <span class="text-muted small">Today's Patients</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-amber"><i class="bi bi-bell"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-warning">@Model.PendingRequestsCount</h4>
                <span class="text-muted small">Pending Requests</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-teal"><i class="bi bi-clock-history"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-teal">@Model.UpcomingAppointmentsCount</h4>
                <span class="text-muted small">Upcoming</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-green"><i class="bi bi-people"></i></div>
            <div>
                <h4 class="fw-bold mb-0 text-success">@Model.TotalPatientsTreated</h4>
                <span class="text-muted small">Total Patients</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Today's Consultations -->
    <div class="col-lg-7">
        <div class="med-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock text-primary me-2"></i> Today's Appointments</h5>
                <a asp-action="Schedule" class="small fw-semibold text-primary text-decoration-none">Full Schedule</a>
            </div>

            @if (!Model.TodayAppointments.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-check2-circle text-muted display-4"></i>
                    <p class="text-muted mt-2 mb-0">No consultations scheduled for today.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Time</th>
                                <th>Patient Name</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var appt in Model.TodayAppointments)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@DateTime.Today.Add(appt.StartTime).ToString("hh:mm tt")</td>
                                    <td>
                                        <a asp-action="PatientDetails" asp-route-id="@appt.PatientId" class="fw-semibold text-dark text-decoration-none">
                                            @appt.Patient.User.FullName
                                        </a>
                                        <div class="text-muted small">@appt.Patient.Gender</div>
                                    </td>
                                    <td class="text-truncate" style="max-width: 150px;">@appt.Reason</td>
                                    <td><span class="badge badge-status badge-@appt.Status.ToLower()">@appt.Status</span></td>
                                    <td class="text-end">
                                        <a asp-action="AddNote" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-journal-plus me-1"></i> Notes
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Pending Requests List -->
    <div class="col-lg-5">
        <div class="med-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bell-fill text-warning me-2"></i> Pending Booking Requests</h5>
                <a asp-action="Requests" class="small fw-semibold text-primary text-decoration-none">View All (@Model.PendingRequestsCount)</a>
            </div>

            @if (!Model.PendingRequests.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox text-muted display-4"></i>
                    <p class="text-muted mt-2 mb-0">No pending requests requiring approval.</p>
                </div>
            }
            else
            {
                <div class="d-grid gap-3">
                    @foreach (var req in Model.PendingRequests)
                    {
                        <div class="bg-light p-3 rounded-3 border">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-dark">@req.Patient.User.FullName</span>
                                <small class="text-primary font-semibold">@req.AppointmentDate.ToString("MMM dd") @DateTime.Today.Add(req.StartTime).ToString("hh:mm tt")</small>
                            </div>
                            <p class="small text-muted mb-2 text-truncate">Reason: @req.Reason</p>
                            <div class="d-flex gap-2">
                                <form asp-action="Approve" asp-route-id="@req.AppointmentId" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success w-100"><i class="bi bi-check-lg"></i> Approve</button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@req.AppointmentId" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-x-lg"></i> Reject</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
