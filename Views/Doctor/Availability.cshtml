@model HospitalAppointmentSystem.ViewModels.AvailabilityFormViewModel
@{
    ViewData["Title"] = "Manage Availability";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row g-4">
    <!-- Schedule Configuration Form -->
    <div class="col-lg-5">
        <div class="med-card p-4">
            <h5 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-primary me-2"></i> Configure Schedule</h5>
            <p class="text-muted small mb-4">Set your available practice hours and slot durations for a specific date.</p>

            <form asp-action="Availability" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DoctorId" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="AvailableDate" class="form-label fw-semibold">Target Date *</label>
                    <input asp-for="AvailableDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
                    <span asp-validation-for="AvailableDate" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="StartTime" class="form-label fw-semibold">Start Time *</label>
                        <input asp-for="StartTime" type="time" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label asp-for="EndTime" class="form-label fw-semibold">End Time *</label>
                        <input asp-for="EndTime" type="time" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="SlotDuration" class="form-label fw-semibold">Slot Duration (Minutes)</label>
                    <select asp-for="SlotDuration" class="form-select">
                        <option value="15">15 Minutes</option>
                        <option value="20">20 Minutes</option>
                        <option value="30">30 Minutes (Recommended)</option>
                        <option value="45">45 Minutes</option>
                        <option value="60">60 Minutes</option>
                    </select>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsAvailable" class="form-check-input" id="availableCheck" />
                    <label class="form-check-label fw-semibold small" for="availableCheck">Mark as Available for Bookings</label>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2">
                    <i class="bi bi-check-circle me-1"></i> Save Schedule Slot
                </button>
            </form>
        </div>
    </div>

    <!-- Active Schedules Table -->
    <div class="col-lg-7">
        <div class="med-card p-4">
            <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Upcoming Configured Schedules</h5>
            @if (!Model.ExistingAvailabilities.Any())
            {
                <p class="text-muted text-center py-4">No custom schedules defined. Default working hours (09:00 AM - 05:00 PM) will apply.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Date</th>
                                <th>Practice Hours</th>
                                <th>Slot Duration</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var avail in Model.ExistingAvailabilities)
                            {
                                <tr>
                                    <td class="fw-semibold">@avail.AvailableDate.ToString("ddd, MMM dd, yyyy")</td>
                                    <td>@DateTime.Today.Add(avail.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(avail.EndTime).ToString("hh:mm tt")</td>
                                    <td>@avail.SlotDuration mins</td>
                                    <td>
                                        @if (avail.IsAvailable)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unavailable</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
