@model HospitalAppointmentSystem.ViewModels.DoctorFormViewModel
@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="med-card p-4 p-md-5">
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-person-vcard text-primary me-2"></i> Doctor Profile Information</h4>
            <p class="text-muted small mb-4">Manage your professional credentials, consultation fees, and profile biography.</p>

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DoctorId" />
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name *</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address (Read Only)</label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold">Contact Phone *</label>
                        <input asp-for="Phone" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label fw-semibold">Department</label>
                        <select asp-for="DepartmentId" class="form-select">
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.DepartmentId" selected="@(Model.DepartmentId == dept.DepartmentId)">@dept.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Qualification" class="form-label fw-semibold">Qualifications / Degrees *</label>
                        <input asp-for="Qualification" class="form-control" required />
                        <span asp-validation-for="Qualification" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Specialization" class="form-label fw-semibold">Specialization Area *</label>
                        <input asp-for="Specialization" class="form-control" required />
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Experience" class="form-label fw-semibold">Clinical Experience (Years)</label>
                        <input asp-for="Experience" type="number" class="form-control" min="0" max="70" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConsultationFee" class="form-label fw-semibold">Consultation Fee ($ USD)</label>
                        <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Biography" class="form-label fw-semibold">Doctor Biography</label>
                        <textarea asp-for="Biography" rows="4" class="form-control" placeholder="Brief summary of clinical expertise, medical background, and patient care philosophy..."></textarea>
                    </div>
                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary-custom px-4 py-2">
                            <i class="bi bi-check-circle me-1"></i> Update Profile Details
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
