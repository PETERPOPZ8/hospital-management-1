@model HospitalAppointmentSystem.ViewModels.DepartmentFormViewModel
@{
    bool isEdit = Model.DepartmentId.HasValue && Model.DepartmentId > 0;
    ViewData["Title"] = isEdit ? "Edit Department" : "Add Department";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="med-card p-4 p-md-5">
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-hospital text-primary me-2"></i> @(isEdit ? "Update Department" : "Add New Department")</h4>
            <p class="text-muted small mb-4">Set department name, description, and icon class.</p>

            <form asp-action="DepartmentForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DepartmentId" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="DepartmentName" class="form-label fw-semibold">Department Name *</label>
                    <input asp-for="DepartmentName" class="form-control" placeholder="e.g. Cardiology, Orthopedics..." required />
                    <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" rows="3" class="form-control" placeholder="Brief clinical description..."></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="IconClass" class="form-label fw-semibold">Bootstrap Icon Class</label>
                    <input asp-for="IconClass" class="form-control" placeholder="bi-heart-pulse-fill, bi-cpu-fill, bi-activity" />
                    <span class="text-muted small">Use standard Bootstrap Icons classes (e.g. bi-heart-pulse-fill)</span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" id="deptActive" />
                    <label class="form-check-label small fw-semibold" for="deptActive">Department Active Status</label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Departments" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom px-4">Save Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
