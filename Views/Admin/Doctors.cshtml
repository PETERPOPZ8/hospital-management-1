@model IEnumerable<HospitalAppointmentSystem.Models.Doctor>
@{
    ViewData["Title"] = "Doctor Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    string search = ViewBag.Search as string ?? "";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-person-badge text-primary me-2"></i> Doctor Management</h4>
        <p class="text-muted small mb-0">Create, update, and manage doctor accounts and department assignments.</p>
    </div>
    <a asp-action="DoctorForm" class="btn btn-primary-custom mt-3 mt-md-0">
        <i class="bi bi-person-plus me-1"></i> Add New Doctor
    </a>
</div>

<!-- Search Filter -->
<div class="med-card p-3 mb-4">
    <form asp-action="Doctors" method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search doctor by name, specialization, or department..." />
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-sm btn-primary-custom"><i class="bi bi-search me-1"></i> Search</button>
        </div>
    </form>
</div>

<div class="med-card p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-person-x text-muted display-4"></i>
            <h5 class="fw-bold text-dark mt-3">No Doctors Found</h5>
            <p class="text-muted small">No doctor records match the criteria.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Doctor Name</th>
                        <th>Department</th>
                        <th>Qualification</th>
                        <th>Specialization</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Dr. @doc.User.FullName</div>
                                <small class="text-muted"><i class="bi bi-envelope me-1"></i> @doc.User.Email</small>
                            </td>
                            <td><span class="badge bg-light text-primary border">@doc.Department.DepartmentName</span></td>
                            <td>@doc.Qualification</td>
                            <td>@doc.Specialization</td>
                            <td class="fw-bold text-success">$@doc.ConsultationFee</td>
                            <td>
                                @if (doc.IsActive && doc.User.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="DoctorForm" asp-route-id="@doc.DoctorId" class="btn btn-sm btn-outline-primary" title="Edit Doctor">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    @if (doc.IsActive)
                                    {
                                        <form asp-action="DeleteDoctor" asp-route-id="@doc.DoctorId" method="post" class="d-inline" data-confirm="Are you sure you want to deactivate Dr. @doc.User.FullName?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate">
                                                <i class="bi bi-dash-circle"></i> Deactivate
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
