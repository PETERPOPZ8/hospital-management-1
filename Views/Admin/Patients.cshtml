@model IEnumerable<HospitalAppointmentSystem.Models.Patient>
@{
    ViewData["Title"] = "Patient Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    string search = ViewBag.Search as string ?? "";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-people text-primary me-2"></i> Patient Directory</h4>
        <p class="text-muted small mb-0">View registered patients and manage account profiles.</p>
    </div>
    <a asp-action="PatientForm" class="btn btn-primary-custom mt-3 mt-md-0">
        <i class="bi bi-person-plus me-1"></i> Register New Patient
    </a>
</div>

<div class="med-card p-3 mb-4">
    <form asp-action="Patients" method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search patient by name, email, or phone..." />
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-sm btn-primary-custom"><i class="bi bi-search me-1"></i> Search</button>
        </div>
    </form>
</div>

<div class="med-card p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-people text-muted display-4"></i>
            <h5 class="fw-bold text-dark mt-3">No Patients Found</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>ID</th>
                        <th>Patient Name</th>
                        <th>Contact Phone</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Total Appointments</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var pat in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@pat.PatientId</td>
                            <td>
                                <div class="fw-bold text-dark">@pat.User.FullName</div>
                                <small class="text-muted">@pat.User.Email</small>
                            </td>
                            <td>@pat.User.Phone</td>
                            <td>@pat.Gender</td>
                            <td>@(pat.DateOfBirth?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                            <td><span class="badge bg-light text-primary border">@pat.Appointments.Count Bookings</span></td>
                            <td class="text-end">
                                <a asp-action="PatientForm" asp-route-id="@pat.PatientId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
